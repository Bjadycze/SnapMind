    <!-- Onboarding -->
    <string name="onboarding_title">Before we start</string>
    <string name="onboarding_intro">SnapMind needs a few permissions to notice your screenshots. You can skip any of them — the app still works when you share things into it.</string>
    <string name="onboarding_continue">Done</string>
    <string name="onboarding_skip">Skip for now</string>

    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_reason">The note prompt is a notification. Without this, nothing appears after a screenshot.</string>

    <string name="perm_media_title">Photos</string>
    <string name="perm_media_reason">Needed to see the screenshot you just took. Choose “Allow all” — partial access does not work for this.</string>

    <string name="perm_battery_title">Battery</string>
    <string name="perm_battery_reason">Without an exemption the system freezes SnapMind overnight and captures stop arriving.</string>

    <string name="perm_autostart_title">Auto-launch</string>
    <string name="perm_autostart_reason">Your phone blocks apps from starting after a restart. Turn on auto-launch for SnapMind, or it stays silent until you open it.</string>

    <string name="perm_hibernation_title">Keep SnapMind awake</string>
    <string name="perm_hibernation_reason">Android switches off apps you rarely open. SnapMind is meant to run without you opening it, so it gets switched off eventually unless you turn this restriction off.</string>

    <string name="perm_dnd_title">Do Not Disturb</string>
    <string name="perm_dnd_reason">Optional. Without it, captures during Do Not Disturb arrive silently instead of popping up. On some phones you also need to add SnapMind to the Do Not Disturb allow-list by hand.</string>

