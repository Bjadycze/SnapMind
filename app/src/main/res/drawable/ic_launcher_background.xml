<?xml version="1.0" encoding="utf-8"?>
<!--
  SnapMind adaptive icon, background layer.
  Full 108x108 bleed with square corners: the launcher applies the mask, so the
  drawable must never round its own corners or it renders as an icon inside an icon.
  Colours sampled from the approved design.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="104"
                android:endX="98"
                android:endY="4">
                <item android:offset="0" android:color="#FF41256A" />
                <item android:offset="0.45" android:color="#FF2E1B4E" />
                <item android:offset="1" android:color="#FF241542" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
